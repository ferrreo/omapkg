# Provisioning only; never bind the token-creation token to a deployed Worker.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_D1_DATABASE_ID=
CLOUDFLARE_TOKEN_CREATION_TOKEN=
CLOUDFLARE_API_TOKEN=
D1_DATABASE_NAME=omapkg
ARTIFACTS_BUCKET_NAME=omapkg-artifacts
R2_LOCATION_HINT=weur

# Worker names are deployment-local and may differ from this template.
WEB_WORKER_NAME=omapkg
PIPELINE_WORKER_NAME=omapkg-pipeline
SIGNER_WORKER_NAME=omapkg-signer
PIPELINE_SERVICE=omapkg-pipeline
SIGNER_SERVICE=omapkg-signer
PIPELINE_INSTANCE_TYPE=basic
PIPELINE_IMAGE=

# Web service only
PUBLIC_ORIGIN=
BETTER_AUTH_SECRET=
CONTROL_TOKEN=
SIGNER_TOKEN=
REGISTRY_ACCOUNT_ID=
REGISTRY_API_TOKEN=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
QUARANTINE_HOURS=48
PACKAGE_SIGNING_FINGERPRINT=
SIGNING_KEY_ID=package-signing-v1

# Recipe integration: prefer a GitHub App restricted to this repository.
GITHUB_REPOSITORY=owner/package-repository
GITHUB_APP_ID=
GITHUB_APP_INSTALLATION_ID=
GITHUB_APP_PRIVATE_KEY=

# Builder host only: short-lived pull credential issuer, not deployment token.
CLOUDFLARE_REGISTRY_TOKEN=

# Optional separate managed KMS signer.
KMS_KEY_ARN=
AWS_REGION=

# Pipeline only. Provider key stays in Cloudflare BYOK.
AI_GATEWAY_TOKEN=
AI_GATEWAY_ACCOUNT_ID=
AI_GATEWAY_ID=default
AI_GATEWAY_BYOK_ALIAS=default
