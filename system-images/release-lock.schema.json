{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["schemaVersion", "authority", "transactionSha256", "transaction", "systemManifest", "oprManifest", "repositories", "packageChunks", "packages", "packageCount", "sourcePackageCount", "packageSetSha256", "architecture", "systemVersion", "oprGeneration", "sourceDateEpoch"],
  "properties": {
    "schemaVersion": {"const": 1},
    "authority": {"const": "omarchy-manifest-client-v1"},
    "transactionSha256": {"$ref": "#/$defs/sha256"},
    "systemManifest": {"$ref": "#/$defs/manifestRef"},
    "oprManifest": {"$ref": "#/$defs/manifestRef"},
    "repositories": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/repository"}},
    "transaction": {"$ref": "#/$defs/manifestRef"},
    "packageChunks": {"type": "array", "items": {"$ref": "#/$defs/chunkRef"}},
    "packages": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/package"}},
    "packageCount": {"type": "integer", "minimum": 1},
    "sourcePackageCount": {"type": "integer", "minimum": 1},
    "packageSetSha256": {"$ref": "#/$defs/sha256"},
    "architecture": {"enum": ["x86_64", "aarch64"]},
    "systemVersion": {"type": "string", "minLength": 1},
    "oprGeneration": {"type": "string", "minLength": 1},
    "sourceDateEpoch": {"type": "integer", "minimum": 1}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "manifestRef": {"type": "object", "required": ["path", "sha256", "signature", "signatureSha256"], "properties": {"path": {"type": "string", "pattern": "^[^/]"}, "sha256": {"$ref": "#/$defs/sha256"}, "signature": {"type": "string", "pattern": "^[^/]"}, "signatureSha256": {"$ref": "#/$defs/sha256"}, "signatureUrl": {"type": "string"}}, "additionalProperties": false},
    "chunkRef": {"type": "object", "required": ["path", "sha256"], "properties": {"path": {"type": "string", "pattern": "^[^/]"}, "sha256": {"$ref": "#/$defs/sha256"}}, "additionalProperties": false},
    "repository": {"type": "object", "required": ["name", "architecture", "path", "sha256", "signature", "signatureSha256", "packageBaseUrl"], "properties": {"name": {"type": "string", "minLength": 1}, "architecture": {"enum": ["x86_64", "aarch64"]}, "path": {"type": "string", "pattern": "^[^/]"}, "sha256": {"$ref": "#/$defs/sha256"}, "signature": {"type": "string", "pattern": "^[^/]"}, "signatureSha256": {"$ref": "#/$defs/sha256"}, "packageBaseUrl": {"type": "string", "pattern": "^https://"}}, "additionalProperties": false},
    "package": {"type": "object", "required": ["releaseId", "name", "version", "architecture", "repository", "filename", "url", "signatureUrl", "sha256", "signatureSha256", "install"], "properties": {"releaseId": {"type": "string", "minLength": 1}, "name": {"type": "string", "minLength": 1}, "version": {"type": "string", "minLength": 1}, "architecture": {"enum": ["x86_64", "aarch64", "any"]}, "repository": {"type": "string", "minLength": 1}, "filename": {"type": "string", "pattern": "^[A-Za-z0-9._+@:-]+\\.pkg\\.tar\\.[A-Za-z0-9]+$"}, "url": {"type": "string", "pattern": "^https://"}, "signatureUrl": {"type": "string", "pattern": "^https://"}, "sha256": {"$ref": "#/$defs/sha256"}, "signatureSha256": {"$ref": "#/$defs/sha256"}, "install": {"type": "boolean"}}, "additionalProperties": false}
  },
  "additionalProperties": false
}
