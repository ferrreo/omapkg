{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["schemaVersion", "authority", "candidate", "transactionSha256", "transaction", "systemManifest", "oprManifest", "repositories", "packageChunks", "packages", "packageCount", "sourcePackageCount", "packageSetSha256", "architecture", "systemVersion", "oprGeneration", "sourceDateEpoch"],
  "properties": {
    "schemaVersion": {"const": 1},
    "authority": {"const": "factory-candidate-v1"},
    "candidate": {
      "type": "object",
      "required": ["id", "executionScope", "ownedUniverseSha256", "inputLockSha256", "nativePlanSha256"],
      "properties": {
        "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]{0,255}$"},
        "executionScope": {"const": "private"},
        "ownedUniverseSha256": {"$ref": "#/$defs/sha256"},
        "inputLockSha256": {"$ref": "#/$defs/sha256"},
        "nativePlanSha256": {"$ref": "#/$defs/sha256"}
      },
      "additionalProperties": false
    },
    "transactionSha256": {"$ref": "#/$defs/sha256"},
    "systemManifest": {"$ref": "#/$defs/manifestRef"},
    "oprManifest": {"$ref": "#/$defs/manifestRef"},
    "repositories": {"type": "array", "minItems": 1},
    "transaction": {"$ref": "#/$defs/manifestRef"},
    "packageChunks": {"type": "array"},
    "packages": {"type": "array", "minItems": 1},
    "packageCount": {"type": "integer", "minimum": 1},
    "sourcePackageCount": {"type": "integer", "minimum": 1},
    "packageSetSha256": {"$ref": "#/$defs/sha256"},
    "architecture": {"enum": ["x86_64", "aarch64"]},
    "systemVersion": {"type": "string", "minLength": 1},
    "oprGeneration": {"type": "string", "minLength": 1},
    "sourceDateEpoch": {"type": "integer", "minimum": 1}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "manifestRef": {"type": "object", "required": ["path", "sha256", "signature", "signatureSha256"], "properties": {"path": {"type": "string", "pattern": "^[^/]"}, "sha256": {"$ref": "#/$defs/sha256"}, "signature": {"type": "string", "pattern": "^[^/]"}, "signatureSha256": {"$ref": "#/$defs/sha256"}, "signatureUrl": {"type": "string"}}, "additionalProperties": false}
  },
  "additionalProperties": false
}
